{
  "name": "faction-standing",
  "version": "2.0.0",
  "private": true,
  "description": "Renown, faction standing and NPC relations for Foundry VTT v14 + dnd5e 6.x.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "link": "node ./tools/link-foundry.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run i18n:check && npm test && npm run build",
    "i18n:check": "node ./tools/check-i18n.mjs",
    "dev": "node build.mjs --watch",
    "release:dry-run": "node tools/foundry-release.mjs --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.40.0"
  }
}
